# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App URL: use http://localhost:3000 locally and your production domain in Vercel.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Discord Integration V1 (server-only secrets; never expose the bot token to the browser).
DISCORD_APPLICATION_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_REDIRECT_URI=http://localhost:3000/api/integrations/discord/callback

# Transactional email (create the key at Resend and configure these in Vercel).
RESEND_API_KEY=
RESEND_FROM_EMAIL=Trading Docks <invites@tradingdocks.com>

# RevenueCat web billing and webhook reconciliation
REVENUECAT_WEBHOOK_AUTHORIZATION=
