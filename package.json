{
  "name": "trading-docks",
  "version": "0.88.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --test --experimental-strip-types tests/*.test.ts",
    "test:pos:db": "node tests/pos-db.mjs && node tests/pos-db.mjs --enum-ledger",
    "test:pos:browser": "node tests/pos-db.mjs --browser",
    "test:pos:print": "node --experimental-strip-types tests/pos-receipt-browser.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:update": "playwright test --update-snapshots",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm test && npm audit --omit=dev --audit-level=high",
    "validate": "npm run check && npm run build",
    "test:labels:print": "node --experimental-strip-types tests/label-print-browser.mjs",
    "test:labels:browser": "node tests/pos-db.mjs --browser"
  },
  "dependencies": {
    "@sparticuz/chromium": "153.0.0",
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.8",
    "@types/qrcode": "^1.5.6",
    "@vercel/oidc": "^3.8.8",
    "bwip-js": "4.11.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jszip": "^3.10.2",
    "lucide-react": "^1.26.0",
    "motion": "^12.42.2",
    "next": "^16.3.4",
    "next-themes": "^0.4.6",
    "puppeteer-core": "^25.11.0",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.6.5",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "^0.35.4",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.3.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "shadcn": "^4.16.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "^8.5.22",
    "sharp": "^0.35.4"
  }
}
