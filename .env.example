

# Optional: enables image recognition in the Card Photo Price Scanner
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4.1-mini

# Purchasing Intelligence marketplace connectors
# Mana Pool offers an official open API. Configure only after obtaining a token
# and confirming the exact production endpoint/permissions from its API docs.
MANAPOOL_API_TOKEN=
MANAPOOL_API_BASE_URL=https://manapool.com/api/v1

# CardSphere connector placeholder
CARDSPHERE_API_TOKEN=
CARDSPHERE_API_BASE_URL=


# Copy the exact official endpoint URLs from Mana Pool API documentation.
MANAPOOL_INVENTORY_IMPORT_URL=
MANAPOOL_ORDERS_IMPORT_URL=
MANAPOOL_PRICING_IMPORT_URL=

# Mana Pool REST API
MANAPOOL_API_BASE_URL=https://manapool.com/api/v1
# Optional ISO timestamp used only for the first sync. Defaults to one year ago.
MANAPOOL_INITIAL_SYNC_SINCE=

# POS Square: server only. Phase 5 requires SANDBOX; production is rejected.
SQUARE_APPLICATION_ID=
SQUARE_APPLICATION_SECRET=
SQUARE_ENVIRONMENT=
SQUARE_OAUTH_REDIRECT_URL=
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_WEBHOOK_NOTIFICATION_URL=
# AES-256-GCM credential storage; server-only key (at least 32 characters).
MARKETPLACE_CREDENTIAL_ENCRYPTION_KEY=
MARKETPLACE_CREDENTIAL_KEY_VERSION=
